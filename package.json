{
  "name": "automationhub",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,yellow \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "build": "npm run build --workspace=client",
    "install:all": "npm install",
    "kb:ingest": "node scripts/ingest-kb.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
