# ── Server ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/automationhub
JWT_SECRET=change_me_to_a_long_random_string
ADMIN_EMAIL=admin@automationhub.ph
ADMIN_PASSWORD_HASH=                      # generate: node -e "require('bcrypt').hash('yourpassword',12).then(console.log)"

# GoHighLevel
GHL_API_KEY=                              # Private Integration Token from GHL Developer Settings
GHL_LOCATION_ID=                          # Your GHL sub-account location ID

# CORS
CLIENT_URL=https://www.automationhub.ph

# ── Client ────────────────────────────────────────────────────────────────────
# (put in client/.env)
VITE_API_URL=http://localhost:3001
VITE_N8N_BASE_URL=https://n8n-production-e454.up.railway.app   # n8n webhook host for the live demo widgets — public demo endpoint, not a secret; code falls back to this value if unset
VITE_AIRTABLE_EMBED_URL=https://airtable.com/embed/app5n2xqzCMgVm8tg/shrmdtr897kOJ31Pq?viewControls=on   # Airtable share-view iframe URL for the CRM Sync demo (Company field only); public read-only view, not a secret; code falls back to this value if unset
VITE_SUPABASE_URL=https://swbstiudmouiyvwrrlyr.supabase.co   # Supabase project backing the Email Triage live feed; code falls back to this value if unset
VITE_SUPABASE_ANON_KEY=                                   # Supabase anon/publishable key, RLS-scoped to SELECT-only on email_triage_feed; not a secret; code falls back to a baked-in value if unset
